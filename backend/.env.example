# Application
APP_NAME="Billing 2.0 API"
APP_ENV="development"
DEBUG=true
PORT=8000
HOST="127.0.0.1"

# CORS
CORS_ORIGINS="http://localhost:5173,http://127.0.0.1:5173"

# MongoDB Configuration
MONGODB_URI="mongodb://localhost:27017"
MONGODB_DB_NAME="billing_db"

# JWT Authentication (Structure placeholder - not fully activated)
JWT_SECRET_KEY="your-secret-key-placeholder"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=60

# File Storage Configuration
STORAGE_TYPE="local"
LOCAL_STORAGE_BASE_DIR="./storage"
